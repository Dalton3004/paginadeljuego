{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "client/main.js",
    "sw.js",
    "sim_offline.js",
    "scripts/*.mjs",
    "tests/*.test.mjs"
  ],
  "project": [
    "*.js",
    "client/**/*.js",
    "game/**/*.js",
    "career/**/*.js",
    "sim/**/*.js",
    "fx/**/*.js",
    "net/**/*.js",
    "obs/**/*.js",
    "rutas/**/*.js",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ],
  "ignore": [
    "sim/boot.js"
  ],
  "ignoreDependencies": [
    "@sentry/node"
  ],
  "rules": {
    "exports": "off",
    "duplicates": "off",
    "types": "off"
  }
}
