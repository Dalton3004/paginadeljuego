{
  // Referencia: DavidAnson/markdownlint (★6.4k+) y htmlhint/HTMLHint (.markdownlint.json)
  "globs": ["*.md"],
  "ignores": ["node_modules/**", "dist/**", "data/**"],
  "config": {
    "default": true,
    "MD007": false,
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD058": false,
    "MD060": false
  }
}
