{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true,
    "serviceworker": true
  },
  "globals": {
    "CONFIG": "readonly",
    "DIFICULTADES": "readonly",
    "EstadoPartido": "readonly",
    "TACTICAS": "readonly",
    "TACTICA_ORDEN": "readonly",
    "Vector2D": "readonly",
    "Pelota": "readonly",
    "Jugador": "readonly",
    "GestorPartido": "readonly",
    "factorEstrellas": "readonly",
    "perfilConEstrellas": "readonly",
    "EQUIPOS": "readonly",
    "SPRITE_ATLAS": "readonly",
    "ANIMACIONES": "readonly",
    "FANS_ATLAS": "readonly",
    "Crowd": "readonly",
    "FX": "readonly",
    "NetSync": "readonly",
    "RankingCore": "readonly",
    "RankingStore": "readonly",
    "RankingUI": "readonly",
    "SettingsStore": "readonly",
    "SettingsUI": "readonly",
    "AuthStore": "readonly",
    "SocialStore": "readonly",
    "SocialUI": "readonly",
    "LigaCore": "readonly",
    "LigaStore": "readonly",
    "LigaModo": "readonly",
    "Preloader": "readonly",
    "Game": "readonly",
    "MOVILIDAD_JUGADORES": "readonly",
    "MatchStats": "readonly",
    "Replay": "readonly",
    "CamaraReplay": "readonly",
    "SeriePenales": "readonly",
    "HistorialLocalStore": "readonly",
    "CopaCore": "readonly",
    "CopaStore": "readonly",
    "CopaModo": "readonly",
    "SupercopaCore": "readonly",
    "SupercopaStore": "readonly",
    "SupercopaModo": "readonly",
    "CarreraStore": "readonly",
    "EquipoFavoritoStore": "readonly",
    "DesafiosStore": "readonly",
    "HistoriaStore": "readonly",
    "io": "readonly"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-underscore-dangle": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "promise/always-return": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/no-lonely-if": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "data/**",
    "assets/sprites/**",
    "assets/hinchada/fans_atlas.js",
    "assets/animaciones.js",
    "assets/movilidad.js",
    "assets/equipos.js"
  ]
}
